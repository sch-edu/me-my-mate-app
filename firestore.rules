rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated, non-anonymous users can read and write their personal knights
    match /users/{userId}/knights/{knightId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Shared knights: public read-only for studying; write operations require non-anonymous auth
    match /sharedKnights/{knightId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
